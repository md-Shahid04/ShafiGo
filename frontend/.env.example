# Backend API Base URL
VITE_API_URL=http://localhost:8080/api

# WebSocket STOMP Endpoint URL
VITE_WS_URL=http://localhost:8080/ws

# Google Maps Platform API Key (Demo or Production)
# Required Google APIs: Maps JavaScript API, Places API, Routes API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
