# ==========================================================
# ShafiGO Backend Environment Configuration Example
# ==========================================================

# Server Port
PORT=8080

# Spring Profiles (mysql or default)
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=swiftride_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
JWT_SECRET=your_base64_or_hex_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Initial Admin Credentials (for seed/auth initialization)
ADMIN_EMAIL=admin@shafigo.com
ADMIN_PASSWORD=your_secure_admin_password_here
